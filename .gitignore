# deeper-circuits program
data_text/*.bin
runs_lm/*/ckpt/
runs_lm/*/val_ce*.npy
logs/text_build.log

# large data/caches (regenerable; keep out of git)
data_owt/train.bin
data_owt/val.bin
runs_lm/*_cache.pt
# bulky training-run artifacts (checkpoints/val-curves) — keep code+results, not GBs of runs
runs_owt/*
!runs_owt/block2-dense-seed0/
runs_owt/block2-dense-seed0/ckpt/
runs_owt/block2-dense-seed0/val_ce.npy
runs_lm/
basis_aligned/qk_mdl/*.pt
basis_aligned/e7_dict_*.pt
medmnist_data/

# ECG program: raw datasets + regenerable read-space caches (keep code+results, not GBs)
ecg_data/
basis_aligned/qk_mdl/ecg_readspace_*.npy
data_fineweb*.npy
data_*.npy

# tiny_full_interp: regenerable corpus shards (rebuild with tf_tokenizer.py for
# tf_corpus_b*, tf_corpus.py for tf_corpus_v*; the per-shard sha256 in
# MANIFEST.json is the byte-identity gate, so the MANIFESTS ARE COMMITTED and
# only the shards are ignored) and run outputs
basis_aligned/tiny_full_interp/*.pt
basis_aligned/tiny_full_interp/*_fold.npz
basis_aligned/tiny_full_interp/*_tables_*.npy
basis_aligned/tiny_full_interp/*_heldloss.npy
basis_aligned/tiny_full_interp/*.out
basis_aligned/tiny_full_interp/*.log
basis_aligned/tiny_full_interp/*.stdout
basis_aligned/tiny_full_interp/tf_corpus_*/*.npy

# live run logs: committing these swaps the inode under a running
# process and detaches its stdout (hit twice on 2026-08-08)
basis_aligned/qk_mdl/*.out
basis_aligned/qk_mdl/*.rescued
basis_aligned/tiny_full_interp/*.out

# large binary arrays -- regenerable from scripts, exceed GitHub limits
*.npz

# bilinear-quotient program: trained checkpoint cache (29MB, deterministic —
# regenerate with `python a2_modular.py`, which retrains and re-saves it if absent)
basis_aligned/bilinear_quotient/a2_cache.pt

# isolated compiler row cache (content-addressed receipt is committed separately)
basis_aligned/bilinear_quotient/.rowcache_compiler_v1/
basis_aligned/bilinear_quotient/.rowcache_compiler_v2/

# bqlib row/forward cache (regenerable)
basis_aligned/bilinear_quotient/.bqcache/

# fitted-stack cache written by ops/frontier_stack_dump.py (1.6 GB, regenerable by rerunning
# that rung; verified bit-exact round-trip, so nothing here is evidence that git needs to hold)
basis_aligned/bilinear_quotient/.fitcache/
basis_aligned/bilinear_quotient/equality_task_reader_commutant_rung479_bundle.pt
basis_aligned/bilinear_quotient/circuits/.registry.lock
basis_aligned/bilinear_quotient/circuits/.fast_screen_ledger.jsonl.lock
basis_aligned/bilinear_quotient/circuits/.active_screen_claims.jsonl.lock
