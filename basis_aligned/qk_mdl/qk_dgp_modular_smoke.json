      "dict_rule": "m = 2r, k = 2 (annealed 4->2), SAE 600 steps batch 2048 lr 0.003, unigram token sampling, revival every 500",
      "cp": "TPI+deflation, R = r, 3 restarts, 8 starts, 60 iters",
      "null": "corrected transplant (fit on permuted-code core, transplant onto SAME real core, nonneg lambdas refit only), margin 0.15",
      "task_gate": "held CE - true-law log-loss on same tokens <= 0.05 (paired form; MC entropy also reported)",
      "codability": "R2 >= 0.8, frequency-weighted; class library = 8 planted selection classes + 24 unit-membership classes; substitution meaning gate",
      "equal_ablation": "pattern-energy-matched arms, damage per unit energy + concentration, one load-bearing head"
    }
